{
  "installCommand": "npm ci --include=optional",
  "buildCommand": "npm install --no-save --include=optional @rollup/rollup-linux-x64-gnu@4.63.3 && npm run build:client",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/db/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}